{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": { "correctness": "error" },
	"jsPlugins": ["./internal/lint/plugin.ts"],
	"rules": {
		"typescript/no-explicit-any": "error",
		"ogygia/no-promise-cache": "error"
	},
	"overrides": [
		{
			"files": [
				"packages/router/src/**",
				"packages/devtools/src/profiler/ui/fake-progress.svelte.ts",
				"packages/core/src/hooks.ts",
				"packages/core/src/plugin/**",
				"packages/core/src/server/**",
				"packages/core/src/context-bridge.ts",
				"packages/core/src/runtime/concurrency.ts",
				"packages/core/src/runtime/core.ts",
				"packages/core/src/runtime/drift-watch.ts",
				"packages/core/src/runtime/interaction.ts",
				"packages/core/src/runtime/interaction-replay.ts",
				"packages/core/src/runtime/kit-page-thread.svelte.ts",
				"packages/core/src/runtime/observe.ts",
				"packages/core/src/runtime/restore.ts",
				"packages/core/src/runtime/schedule.ts",
				"packages/core/src/runtime/svelte-warnings.ts",
				"packages/core/src/runtime/wire-classes.ts",
				"packages/core/src/runtime/entry-locations.ts",
				"packages/core/src/runtime/frame-nav.ts",
				"packages/core/src/runtime/frames.ts",
				"packages/core/src/runtime/navigation.ts",
				"packages/core/src/runtime/router.ts",
				"packages/core/src/runtime/router-nav.ts",
				"packages/core/src/runtime/seeds.ts",
				"packages/core/src/runtime/session.ts",
				"packages/core/src/runtime/soft-refresh.ts",
				"packages/core/src/insights/page-assets.ts",
				"packages/federation/src/**",
				"packages/flags/src/ofrep.ts",
				"packages/devtools/src/profiler/net.ts",
				"packages/testing/src/**"
			],
			"rules": { "ogygia/owned-effects": "error" }
		}
	],
	"ignorePatterns": [
		"**/dist/**",
		"**/build/**",
		"**/.svelte-kit/**",
		"**/.vercel/**",
		"svelte/**",
		"kit/**",
		".heisenbench/**",
		"packages/*/bench/__heisenbench.d.ts"
	]
}
