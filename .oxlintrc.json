{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": { "correctness": "error" },
	"jsPlugins": ["./internal/lint/plugin.ts"],
	"options": { "typeAware": true },
	"rules": {
		"typescript/no-explicit-any": "error",
		"typescript/no-deprecated": "error",
		"typescript/await-thenable": "error",
		"typescript/no-array-delete": "error",
		"typescript/no-base-to-string": "off",
		"typescript/no-duplicate-type-constituents": "error",
		"typescript/no-floating-promises": [
			"error",
			{
				"allowForKnownSafeCalls": [
					{
						"from": "package",
						"package": "node:test",
						"name": [
							"test",
							"it",
							"describe",
							"suite",
							"before",
							"after",
							"beforeEach",
							"afterEach"
						]
					}
				]
			}
		],
		"typescript/no-for-in-array": "error",
		"typescript/no-implied-eval": "error",
		"typescript/no-meaningless-void-operator": "error",
		"typescript/no-misused-spread": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-unsafe-unary-minus": "error",
		"typescript/no-useless-default-assignment": "error",
		"typescript/require-array-sort-compare": "error",
		"typescript/restrict-template-expressions": "error",
		"typescript/unbound-method": "error",
		"ogygia/no-promise-cache": "error",
		"ogygia/owned-effects": "error",
		"ogygia/no-silent-failures": "error",
		"ogygia/stale-whole": "error",
		"ogygia/no-string-concat": "error",
		"ogygia/prefer-dedent": "error",
		"ogygia/html-sink": "error",
		"ogygia/one-markup-walk": "error",
		"ogygia/one-hash": "error",
		"ogygia/compiler-boundary": "error",
		"ogygia/dispose-by-close": "error",
		"ogygia/ports": "error",
		"ogygia/tests-read-source": "error",
		"ogygia/fake-timers-whole": "error",
		"ogygia/prefer-class-for-state": "warn"
	},
	"overrides": [
		{
			"files": ["packages/*/src/**/*.ts"],
			"rules": { "ogygia/markup-from-vocabulary": "error" }
		},
		{
			"files": ["packages/*/src/**"],
			"rules": { "no-eval": "error", "no-new-func": "error", "no-implied-eval": "error" }
		},
		{
			"files": [
				"packages/barrels/src/**",
				"packages/cli/src/**",
				"packages/compiler/src/**",
				"packages/config/src/**",
				"packages/content/src/**",
				"packages/data-shake/src/**",
				"packages/federation/src/**",
				"packages/flags/src/**",
				"packages/jumpstart/src/**",
				"packages/machine/src/**",
				"packages/rewrite/src/**",
				"packages/router/src/**",
				"packages/testing/src/**"
			],
			"rules": { "no-nested-ternary": "error" }
		},
		{
			"files": [
				"packages/compiler/src/**",
				"packages/cli/src/**",
				"packages/tooling/src/**",
				"packages/config/src/**",
				"packages/testing/src/**",
				"packages/barrels/src/**",
				"packages/tsdown-plugin-svelte/src/**",
				"packages/*/src/vite/**",
				"packages/devtools/src/**",
				"packages/core/src/runtime/beacon.ts"
			],
			"rules": { "ogygia/ports": "off" }
		},
		{
			"files": [
				"packages/compiler/src/**",
				"packages/cli/src/**",
				"packages/tooling/src/**",
				"packages/config/src/**",
				"packages/testing/src/index.ts",
				"packages/barrels/src/**",
				"packages/tsdown-plugin-svelte/src/**",
				"packages/*/src/vite/**"
			],
			"rules": { "ogygia/dispose-by-close": "off" }
		},
		{
			"files": ["packages/compiler/src/**"],
			"rules": { "ogygia/structured-comments": "error" }
		},
		{
			"files": ["packages/*/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@sveltejs/kit/internal", "@sveltejs/kit/internal/*"],
								"message": "Kit's private modules are imported only by packages/core/src/server/kit-request-store.ts (#1724): read the event through server/live-event.ts (Kit's public getRequestEvent), or add the read there with its canary"
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/core/src/server/kit-request-store.ts"],
			"rules": { "no-restricted-imports": "off" }
		},
		{
			"files": ["packages/core/test/wire-markup.test.ts"],
			"rules": { "ogygia/tests-read-source": "off" }
		}
	],
	"ignorePatterns": [
		"**/dist/**",
		"**/build/**",
		"**/.svelte-kit/**",
		"**/.vercel/**",
		"svelte/**",
		"kit/**",
		".heisenbench/**",
		"apps/palaestra/e2e/adapters/fixture/**",
		"packages/*/bench/__heisenbench.d.ts"
	]
}
