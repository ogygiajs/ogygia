{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": { "correctness": "error" },
	"jsPlugins": ["./internal/lint/plugin.ts"],
	"rules": {
		"typescript/no-explicit-any": "error",
		"ogygia/no-promise-cache": "error",
		"ogygia/owned-effects": "error",
		"ogygia/no-silent-failures": "error",
		"ogygia/stale-whole": "error",
		"ogygia/no-string-concat": "error",
		"ogygia/prefer-dedent": "error",
		"ogygia/html-sink": "error",
		"ogygia/one-hash": "error",
		"ogygia/compiler-boundary": "error",
		"ogygia/ports": "error"
	},
	"overrides": [
		{
			"files": ["packages/*/src/**/*.ts"],
			"rules": { "ogygia/markup-from-vocabulary": "error" }
		},
		{
			"files": ["packages/*/src/**"],
			"rules": { "no-eval": "error", "no-new-func": "error", "no-implied-eval": "error" }
		},
		{
			"files": [
				"packages/compiler/src/**",
				"packages/cli/src/**",
				"packages/tooling/src/**",
				"packages/config/src/**",
				"packages/testing/src/**",
				"packages/barrels/src/**",
				"packages/tsdown-plugin-svelte/src/**",
				"packages/*/src/vite/**",
				"packages/*/src/compiler/**",
				"packages/devtools/src/**",
				"packages/core/src/runtime/beacon.ts"
			],
			"rules": { "ogygia/ports": "off" }
		}
	],
	"ignorePatterns": [
		"**/dist/**",
		"**/build/**",
		"**/.svelte-kit/**",
		"**/.vercel/**",
		"svelte/**",
		"kit/**",
		".heisenbench/**",
		"packages/*/bench/__heisenbench.d.ts"
	]
}
