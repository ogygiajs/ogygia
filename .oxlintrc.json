{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": { "correctness": "error" },
	"jsPlugins": ["./internal/lint/plugin.ts"],
	"rules": {
		"typescript/no-explicit-any": "error",
		"ogygia/no-promise-cache": "error",
		"ogygia/owned-effects": "error",
		"ogygia/no-silent-failures": "error",
		"ogygia/stale-whole": "error",
		"ogygia/one-hash": "error",
		"ogygia/compiler-boundary": "error"
	},
	"overrides": [
		{
			"files": ["packages/*/src/**/*.ts"],
			"rules": { "ogygia/markup-from-vocabulary": "error" }
		},
		{
			"files": ["packages/*/src/**"],
			"rules": { "no-eval": "error", "no-new-func": "error", "no-implied-eval": "error" }
		}
	],
	"ignorePatterns": [
		"**/dist/**",
		"**/build/**",
		"**/.svelte-kit/**",
		"**/.vercel/**",
		"svelte/**",
		"kit/**",
		".heisenbench/**",
		"packages/*/bench/__heisenbench.d.ts"
	]
}
