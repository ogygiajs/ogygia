# Slidev talk nested installs / builds
/talks/*/node_modules/
/talks/*/dist/
/talks/*/.slidev/

# Claude Code local (machine-specific) settings
.claude/settings.local.json
scratch-*.mjs

# bcms header lab — copied Schneider source + captured feeds; NEVER committed
internal/repro-bcms-header/
# PES (product catalog) lab — same rule: copied Schneider source, se.com captures, vendored bundles
internal/repro-pes/
# footer lab (the main ogygia PR's footer → remote functions + lake) — same rule, never committed
internal/repro-ogygia-footer/

