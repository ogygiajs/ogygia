# upstream reference clones — not part of this repo
/kit/
/svelte/

node_modules/
.pnpm-store/
.turbo/
.svelte-kit/
.svelte-dts/
/apps/palaestra/build/
/apps/docs/build/
dist/
# declarations a type check emits beside the source: a package's d.ts is built into dist. The
# hand-written ones are kept by name.
/packages/*/src/**/*.d.ts
!/packages/content/src/app-server.d.ts
!/packages/core/src/types.d.ts
!/packages/devtools/src/ambient.d.ts
!/packages/federation/src/ambient.d.ts
!/packages/postrender/src/ambient.d.ts
# (a planted duplicate module: the devtools lab imports one package by its src and its dist path —
# the dist copy IS the fixture)
!/packages/devtools/e2e/app/src/lib/dup-pkg/dist/
*.log
.DS_Store
.env
.env.*
!.env.example
.vercel
*.tmp.mjs
*.tmp.*
# the CPU profile internal/checks/server-cost.ts writes on each run
/internal/checks/results/server-cost-prof/

# leftover on-disk island dirs from older ogygia versions (now virtual: modules)
**/.ogygia/
# build-time keep-client route (injected + removed by the plugin; only survives a crashed build)
**/.ogygia-keep-client/

# local experiments — not part of the published library
/experiment/

# self-building e2e fixtures (their e2e scripts build them every run)
/internal/repro-deep-csr/build/
/packages/*/e2e/app/build/

# Playwright runner output (traces on failure, html report) + Vitest browser-mode failure screenshots
test-results/
.vitest-attachments/
playwright-report/
playwright-results/
# Vitest coverage (.github/scripts/test-report.ts writes the tests report's own copy)
coverage/
**/__screenshots__/
# one-off screenshots taken while checking the devtools / profiler UI
/anchors.png
**/hub.png

# examples: generated signing keys + build freeze
/examples/mfe/keys.env
/examples/mfe/*/build/
/examples/mfe/*/.svelte-kit/

# Slidev talk nested installs / builds
/talks/*/node_modules/
/talks/*/dist/
/talks/*/.slidev/

# Claude Code local (machine-specific) settings
.claude/settings.local.json
scratch-*.mjs

# local labs — never committed
internal/repro-header-lab/
internal/repro-catalog/
# footer lab (the main ogygia PR's footer → remote functions + lake) — same rule, never committed
internal/repro-ogygia-footer/

# Turborepo
.turbo

# Heisenbench (the bench files' engine, internal/heisenbench): its checkout, the bench files' generated types,
# and the report the bench CLI writes to the cwd when --out is not given
/.heisenbench/
/packages/*/bench/__heisenbench.d.ts
/heisenbench-report.json
# The simulator's run summaries (internal/sim: `pnpm sim` and the scheduled run write them)
/internal/sim/results.json
/internal/sim/dst-results.json
/internal/sim/plans/
# a shrink's regression test and hand probes: test/found holds only tests put there on purpose
/internal/sim/.scratch/
