/internal/checks/results/server-cost-prof/

# leftover on-disk island dirs from older ogygia versions (now virtual: modules)
**/.ogygia/
# build-time keep-client route (injected + removed by the plugin; only survives a crashed build)
**/.ogygia-keep-client/

# local experiments — not part of the published library
/experiment/

# self-building e2e fixtures (their e2e scripts build them every run)
/internal/repro-deep-csr/build/
/packages/*/e2e/app/build/

# Playwright runner output (traces on failure, html report) + Vitest browser-mode failure screenshots
test-results/
.vitest-attachments/
playwright-report/
**/__screenshots__/
