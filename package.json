{
	"name": "ogygia-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build:lib": "turbo run build --filter=./packages/*",
		"build": "pnpm run build:lib && pnpm --filter palaestra build",
		"build:docs": "pnpm run build:lib && pnpm --filter docs build",
		"dev": "pnpm run build:lib && pnpm --filter palaestra dev",
		"dev:docs": "pnpm run build:lib && pnpm --filter docs dev",
		"docs:dev": "pnpm run build:lib && pnpm --filter docs dev",
		"preview": "pnpm --filter palaestra preview",
		"preview:docs": "pnpm --filter docs preview",
		"check:lib": "turbo run check --filter=./packages/*",
		"check:palaestra": "turbo run check --filter=palaestra",
		"check:docs": "turbo run check --filter=docs",
		"check:bench": "node internal/heisenbench/src/check.ts",
		"bench:types": "node internal/heisenbench/src/types.ts",
		"bench:unmeasured": "node internal/heisenbench/src/unmeasured.ts",
		"test:e2e": "node packages/tooling/src/e2e/run.ts",
		"test:e2e:fast": "E2E_NO_BUILD=1 node packages/tooling/src/e2e/run.ts",
		"test:e2e:serial": "turbo run e2e --concurrency=1",
		"check": "turbo run check --filter=./packages/* --filter=./packages/*/e2e/* --filter=./apps/*",
		"test:adapters": "pnpm --filter palaestra e2e adapters",
		"demo:esi": "node packages/postrender/e2e/demo-esi.ts",
		"bundle-size": "node apps/palaestra/e2e/bundle-size.ts",
		"profiler:answer-key": "node internal/checks/profiler-answer-key.ts --serve --build",
		"profiler:answer-key:no-maps": "node internal/checks/profiler-answer-key.ts --serve --build --no-maps",
		"changeset": "changeset",
		"ci:version": "changeset version",
		"ci:release": "changeset publish",
		"format": "oxfmt .",
		"format:check": "git ls-files -z | xargs -0 oxfmt --check --no-error-on-unmatched-pattern",
		"lint": "oxlint",
		"lint:test": "node --test internal/lint/*.test.ts internal/checks/*.test.ts",
		"ci:test": "node --test .github/scripts/*.test.ts"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"axe-core": "catalog:",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"playwright": "catalog:",
		"rolldown": "catalog:",
		"turbo": "^2.11.10",
		"typescript": "catalog:tsgo"
	},
	"packageManager": "pnpm@12.16.1"
}
