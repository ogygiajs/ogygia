{
	"name": "@ogygia/insights",
	"version": "0.13.0",
	"description": "The analysis engine for ogygia: what the browser measured on a page visit or a recorded session, turned into findings for the devtools dock, the profiler's report and @ogygia/testing",
	"keywords": [
		"devtools",
		"ogygia",
		"performance",
		"sveltekit",
		"web-vitals"
	],
	"homepage": "https://ogygiajs.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/insights"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "pnpm run build",
		"check": "tsc -p . && tsc -p test && vitest run",
		"test": "vitest run"
	},
	"dependencies": {
		"@ogygia/machine": "workspace:^",
		"devalue": "catalog:"
	},
	"devDependencies": {
		"@ogygia/config": "workspace:*",
		"@ogygia/core": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"svelte": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/core": "workspace:^"
	}
}
