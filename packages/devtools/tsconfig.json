{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"declaration": true,
		"isolatedDeclarations": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"customConditions": ["ogygia-source"]
	},
	"include": ["src", "../../internal/macros/macros.d.ts"]
}
