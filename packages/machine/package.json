{
	"name": "@ogygia/machine",
	"version": "0.12.3",
	"description": "Tiny typed state machines for ogygia: one state value, checked moves, async work that cannot land late",
	"keywords": [
		"fsm",
		"ogygia",
		"state-machine",
		"typescript"
	],
	"homepage": "https://ogygiajs.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/machine"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./internal/messages": {
			"types": "./dist/messages.d.ts",
			"default": "./src/messages.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./internal/messages": {
				"types": "./dist/messages.d.ts",
				"default": "./dist/messages.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc -p . && tsc -p test && vitest run",
		"test": "vitest run"
	},
	"dependencies": {
		"esm-env": "catalog:"
	},
	"devDependencies": {
		"@ogygia/tooling": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"@vitest/browser": "4.1.12",
		"@vitest/browser-playwright": "4.1.12",
		"playwright": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
