{
	"name": "@ogygia/machine",
	"version": "0.14.0",
	"description": "Tiny typed state machines for ogygia: one state value, checked moves, async work that cannot land late",
	"keywords": [
		"fsm",
		"ogygia",
		"state-machine",
		"typescript"
	],
	"homepage": "https://ogygiajs.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/machine"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./src/testing.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "pnpm run build",
		"check": "tsc -p . && tsc -p test && vitest run",
		"test": "vitest run"
	},
	"dependencies": {
		"esm-env": "catalog:"
	},
	"devDependencies": {
		"@ogygia/config": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"fast-check": "catalog:",
		"playwright": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
