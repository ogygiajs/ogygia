{
	"name": "@ogygia/tooling",
	"version": "0.0.0",
	"private": true,
	"description": "The e2e harness the ogygia packages and apps share: each playwright.config.ts calls suite(), each spec uses check(), spawn_server and the regexes (@ogygia/tooling/e2e). The build and test config is @ogygia/config.",
	"type": "module",
	"exports": {
		"./e2e": "./src/e2e/index.ts",
		"./e2e/*": "./src/e2e/*",
		"./tsconfig.e2e.json": "./tsconfig.e2e.json"
	},
	"scripts": {
		"check": "tsc -p . && vitest run",
		"test": "vitest run"
	},
	"dependencies": {
		"@ogygia/machine": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@playwright/test": "catalog:"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		}
	}
}
