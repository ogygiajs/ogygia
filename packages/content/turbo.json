{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"check": {
			"dependsOn": ["^build", "ogygia#build"],
			"inputs": ["$TURBO_DEFAULT$"]
		},
		"test": {
			"dependsOn": ["^build", "ogygia#build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!e2e/*",
				"!playwright.config.ts",
				"e2e/app/package.json",
				"e2e/app/src/**",
				"e2e/app/svelte.config.js",
				"e2e/app/tsconfig.json",
				"e2e/app/vite.config.ts"
			]
		},
		"e2e": {
			"dependsOn": ["^build", "build", "content-e2e-app#fixture"]
		}
	}
}
