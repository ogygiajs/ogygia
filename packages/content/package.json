{
	"name": "@ogygia/content",
	"version": "0.13.0",
	"description": "Content for ogygia: collections, markdown with Shiki, docs and blog shells, search, and the content macros",
	"keywords": [
		"content",
		"docs",
		"markdown",
		"mdsvex",
		"ogygia",
		"shiki",
		"sveltekit"
	],
	"homepage": "https://ogygiajs.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/content"
	},
	"files": [
		"dist",
		"ambient.d.ts",
		"README.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"svelte": "./src/server.ts",
			"default": "./src/server.ts"
		},
		"./markdown": {
			"types": "./dist/markdown/index.d.ts",
			"default": "./dist/markdown/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./src/vite/index.ts"
		},
		"./internal/messages": {
			"types": "./dist/messages/index.d.ts",
			"default": "./src/messages/index.ts"
		},
		"./slot": {
			"types": "./dist/site/components/SiteSlot.svelte.d.ts",
			"svelte": "./src/site/components/SiteSlot.svelte",
			"default": "./src/site/components/SiteSlot.svelte"
		},
		"./docs-shell": {
			"types": "./dist/site/components/DocsShell.svelte.d.ts",
			"svelte": "./src/site/components/DocsShell.svelte",
			"default": "./src/site/components/DocsShell.svelte"
		},
		"./theme.css": "./src/site/theme.css",
		"./shell.css": "./src/site/shell.css",
		"./themes/*": "./src/site/themes/*",
		"./types": {
			"types": "./ambient.d.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./server": {
				"types": "./dist/server.d.ts",
				"svelte": "./dist/server.js",
				"default": "./dist/server.js"
			},
			"./markdown": {
				"types": "./dist/markdown/index.d.ts",
				"default": "./dist/markdown/index.js"
			},
			"./vite": {
				"types": "./dist/vite/index.d.ts",
				"default": "./dist/vite/index.js"
			},
			"./internal/messages": {
				"types": "./dist/messages/index.d.ts",
				"default": "./dist/messages/index.js"
			},
			"./slot": {
				"types": "./dist/site/components/SiteSlot.svelte.d.ts",
				"svelte": "./dist/site/components/SiteSlot.svelte",
				"default": "./dist/site/components/SiteSlot.svelte"
			},
			"./docs-shell": {
				"types": "./dist/site/components/DocsShell.svelte.d.ts",
				"svelte": "./dist/site/components/DocsShell.svelte",
				"default": "./dist/site/components/DocsShell.svelte"
			},
			"./theme.css": "./dist/site/theme.css",
			"./shell.css": "./dist/site/shell.css",
			"./themes/*": "./dist/site/themes/*",
			"./types": {
				"types": "./ambient.d.ts"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "pnpm run build",
		"check": "tsc -p . && svelte-check --tsconfig ./tsconfig.check.json --fail-on-warnings && tsc -p test && tsc -p e2e && vitest run",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@ogygia/machine": "workspace:^",
		"@orama/orama": "^3.1.18",
		"bits-ui": "catalog:",
		"magic-string": "catalog:",
		"mdsvex": "catalog:"
	},
	"devDependencies": {
		"@ogygia/config": "workspace:*",
		"@ogygia/core": "workspace:*",
		"@ogygia/tooling": "workspace:*",
		"@playwright/test": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"shiki": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"valibot": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/core": "workspace:^",
		"@sveltejs/kit": "catalog:peers",
		"shiki": "catalog:peers",
		"svelte": "catalog:peers",
		"vite": "catalog:peers"
	}
}
