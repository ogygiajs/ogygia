{
	"name": "@ogygia/federation",
	"version": "0.13.0",
	"description": "Fragment federation for ogygia: apps share pages and widgets as signed region values, with cross-app thaw",
	"keywords": [
		"federation",
		"fragments",
		"microfrontends",
		"ogygia",
		"sveltekit"
	],
	"homepage": "https://ogygiajs.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/federation"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./src/vite.ts"
		},
		"./shared": {
			"types": "./dist/shared-state.d.ts",
			"default": "./src/shared-state.ts"
		},
		"./internal/messages": {
			"types": "./dist/messages.d.ts",
			"default": "./src/messages.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./shared": {
				"types": "./dist/shared-state.d.ts",
				"default": "./dist/shared-state.js"
			},
			"./internal/messages": {
				"types": "./dist/messages.d.ts",
				"default": "./dist/messages.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "pnpm run build",
		"check": "tsc -p . && tsc -p test && tsc -p e2e && vitest run",
		"test": "vitest run",
		"e2e": "playwright test",
		"e2e:built": "OGYGIA_MFE_BUILD=1 playwright test"
	},
	"dependencies": {
		"@ogygia/machine": "workspace:^",
		"devalue": "catalog:"
	},
	"devDependencies": {
		"@ogygia/compiler": "workspace:*",
		"@ogygia/config": "workspace:*",
		"@ogygia/core": "workspace:*",
		"@ogygia/flags": "workspace:*",
		"@ogygia/postrender": "workspace:*",
		"@ogygia/router": "workspace:*",
		"@ogygia/tooling": "workspace:*",
		"@playwright/test": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"svelte": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/compiler": "workspace:^",
		"@ogygia/core": "workspace:^",
		"@ogygia/router": "workspace:^",
		"svelte": "catalog:peers",
		"vite": "catalog:peers"
	}
}
