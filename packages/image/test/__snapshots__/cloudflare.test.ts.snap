// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the capability table, row by row 1`] = `
"| encoder          | need                    | can   | as                                                                                |
| ---------------- | ----------------------- | ----- | --------------------------------------------------------------------------------- |
| sharp            | box                     | true  | resize fit 'cover'                                                                |
| sharp            | crop                    | true  | resize fit 'cover'                                                                |
| sharp            | position center         | true  | position 'centre'                                                                 |
| sharp            | position top            | true  | position 'top'                                                                    |
| sharp            | position bottom         | true  | position 'bottom'                                                                 |
| sharp            | position left           | true  | position 'left'                                                                   |
| sharp            | position right          | true  | position 'right'                                                                  |
