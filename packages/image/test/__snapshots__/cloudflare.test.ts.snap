| sharp            | source gif              | true  | reads GIF                                                                         |
| sharp            | source tiff             | true  | reads TIFF                                                                        |
| sharp            | animated                | true  | { animated: true } keeps every frame                                              |
| sharp            | still                   | true  | { pages: 1 } reads the first frame                                                |
| cloudflare       | box                     | true  | fit=cover (fit=crop for a remote source: never enlarged)                          |
| cloudflare       | crop                    | true  | fit=cover (fit=crop for a remote source: never enlarged)                          |
| cloudflare       | position center         | true  | no gravity (the center is the default)                                            |
| cloudflare       | position top            | true  | gravity=top                                                                       |
| cloudflare       | position bottom         | true  | gravity=bottom                                                                    |
| cloudflare       | position left           | true  | gravity=left                                                                      |
| cloudflare       | position right          | true  | gravity=right                                                                     |
| cloudflare       | position attention      | true  | gravity=auto (saliency)                                                           |
| cloudflare       | position entropy        | false | no gravity keeps the busiest part                                                 |
| cloudflare       | rotate quarter          | true  | rotate=90\\|180\\|270                                                               |
| cloudflare       | rotate other            | false | rotate takes 90, 180 or 270 only                                                  |
| cloudflare       | flip                    | true  | flip=v                                                                            |
| cloudflare       | flop                    | true  | flip=h                                                                            |
| cloudflare       | grayscale               | true  | saturation=0                                                                      |
| cloudflare       | blur                    | true  | blur=<radius 1–250> (twice the sigma)                                             |
| cloudflare       | sharpen                 | true  | sharpen=1                                                                         |
| cloudflare       | normalize               | false | no option stretches the levels                                                    |
| cloudflare       | negate                  | false | no option inverts the colors                                                      |
| cloudflare       | gamma                   | false | gamma is an exposure curve there, not sharp's gamma-correct resize                |
| cloudflare       | tint                    | false | no option tints                                                                   |
