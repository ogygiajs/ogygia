| sharp            | position entropy        | true  | strategy.entropy                                                                  |
| sharp            | rotate quarter          | true  | rotate()                                                                          |
| sharp            | rotate other            | true  | rotate()                                                                          |
| sharp            | flip                    | true  | flip()                                                                            |
| sharp            | flop                    | true  | flop()                                                                            |
| sharp            | grayscale               | true  | grayscale()                                                                       |
| sharp            | blur                    | true  | blur(sigma)                                                                       |
