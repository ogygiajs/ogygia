{
	"name": "@ogygia/config",
	"version": "0.0.0",
	"private": true,
	"description": "Shared build and test config for the ogygia packages: each package's tsdown.config.ts calls library(), its vitest.config.ts pluginTests(), its simulation tests simulate().",
	"type": "module",
	"exports": {
		"./tsdown": "./src/tsdown.ts",
		"./vitest": "./src/vitest.ts",
		"./sim": "./src/sim.ts",
		"./html-fuzz": "./src/html-fuzz.ts"
	},
	"scripts": {
		"check": "tsc -p ."
	},
	"dependencies": {
		"@ogygia/tsdown-plugin-svelte": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/browser-webdriverio": "catalog:",
		"webdriverio": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"fast-check": "catalog:",
		"parse5": "catalog:",
		"svelte": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"tsdown": "catalog:",
		"vitest": "catalog:"
	}
}
