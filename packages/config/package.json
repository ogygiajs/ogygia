	},
	"dependencies": {
		"@ogygia/tsdown-plugin-svelte": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"tsdown": "catalog:",
		"vitest": "catalog:"
	}
}
