{
	"name": "@ogygia/testing",
	"version": "0.14.0",
	"description": "Testing for ogygia: the devtools and the profiler as test primitives, for Playwright or any runner and page driver",
	"keywords": [
		"ogygia",
		"performance",
		"playwright",
		"sveltekit",
		"testing",
		"web-vitals"
	],
	"homepage": "https://ogygiajs.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/testing"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./src/vite.ts"
		},
		"./internal/messages": {
			"types": "./dist/messages.d.ts",
			"default": "./src/messages.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./internal/messages": {
				"types": "./dist/messages.d.ts",
				"default": "./dist/messages.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown && node scripts/engine-script.ts",
		"prepublishOnly": "pnpm run build",
		"check": "tsc -p . && tsc -p test && tsc -p e2e && vitest run",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@ogygia/insights": "workspace:^",
		"@ogygia/machine": "workspace:^"
	},
	"devDependencies": {
		"@ogygia/compiler": "workspace:*",
		"@ogygia/config": "workspace:*",
		"@ogygia/core": "workspace:*",
		"@ogygia/devtools": "workspace:*",
		"@ogygia/tooling": "workspace:*",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:tsgo",
		"rolldown": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/compiler": "workspace:^",
		"@ogygia/core": "workspace:^",
		"@playwright/test": "catalog:peers",
		"vite": "catalog:peers"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	}
}
