{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"ignoreCommand": "[ \"$VERCEL_ENV\" = production ] && exit 1; b=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e $b || exit 1; git diff --quiet $b HEAD -- ':/apps/docs' ':/packages' ':/package.json' ':/pnpm-*' ':/turbo.json'",
	"headers": [
		{
			"source": "/_app/immutable/(.*)",
			"headers": [
				{ "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
				{ "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
			]
		}
	],
	"redirects": [
		{
			"source": "/docs/data-state/freeze",
			"destination": "/docs/data-state/postrender",
			"permanent": true
		},
		{
			"source": "/docs/data-state/freeze.md",
			"destination": "/docs/data-state/postrender.md",
			"permanent": true
		},
		{ "source": "/docs/api/freeze", "destination": "/docs/api/postrender", "permanent": true },
		{ "source": "/docs/api/freeze.md", "destination": "/docs/api/postrender.md", "permanent": true }
	]
}
