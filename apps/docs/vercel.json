{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"ignoreCommand": "[ \"$VERCEL_ENV\" = production ] && exit 1; b=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e $b || exit 1; git diff --quiet $b HEAD -- ':/apps/docs' ':/packages' ':/package.json' ':/pnpm-*' ':/turbo.json'",
	"git": {
		"deploymentEnabled": { "**": false, "latest": true, "main": true, "changeset-release/*": true }
	},
	"headers": [
		{
			"source": "/_app/immutable/(.*)",
			"headers": [
				{ "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
				{ "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
			]
		}
	],
	"redirects": [
		{
			"source": "/docs/data-state/freeze",
			"destination": "/docs/postrender/guide",
			"permanent": true
		},
		{
			"source": "/docs/data-state/freeze.md",
			"destination": "/docs/postrender/guide.md",
			"permanent": true
		},
		{
			"source": "/docs/api/freeze",
			"destination": "/docs/postrender/api/postrender",
			"permanent": true
		},
		{
			"source": "/docs/api/freeze.md",
			"destination": "/docs/postrender/api/postrender.md",
			"permanent": true
		}
	]
}
