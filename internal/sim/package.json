{
	"name": "ogygia-internal-sim",
	"private": true,
	"description": "Deterministic simulation of whole ogygia apps: one seed drives the servers, the tabs, the network, the CDN, deploys and time. Private tooling, never published (internal/notes/dst.md).",
	"type": "module",
	"scripts": {
		"sim": "node --experimental-vm-modules --no-warnings src/cli.ts",
		"sim:long": "node --experimental-vm-modules --no-warnings src/cli.ts --long",
		"sim:builds": "node --no-warnings src/builds.ts",
		"sim:gen": "node --no-warnings src/gen.ts",
		"check": "tsc -p . && vitest run",
		"test": "vitest run"
	},
	"dependencies": {
		"@ogygia/machine": "workspace:^",
		"happy-dom": "catalog:sim"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"fast-check": "catalog:",
		"rolldown": "catalog:",
		"typescript": "catalog:tsgo",
		"vitest": "catalog:"
	}
}
