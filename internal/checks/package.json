{
	"name": "ogygia-internal-checks",
	"private": true,
	"description": "ogygia's internal checks: the devtools and profiler answer keys, the compiler stress run, the server-cost and client-boot measurements, and the cache check (two real builds against a browser that keeps its cache).",
	"type": "module",
	"scripts": {
		"e2e": "node cache-bust-check.ts",
		"keys": "node all-keys.ts",
		"keys:quick": "node all-keys.ts --quick",
		"cache-bust": "node cache-bust-check.ts",
		"compiler-stress": "node compiler-stress.ts",
		"server-cost": "node server-cost.ts",
		"client-boot": "node client-boot.ts",
		"prop-contract": "node integration-prop-contract.ts"
	},
	"devDependencies": {
		"@ogygia/core": "workspace:*",
		"@ogygia/devtools": "workspace:*",
		"@ogygia/tsdown-plugin-svelte": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"devtools-e2e-app": "workspace:*",
		"ogygia": "workspace:*",
		"svelte": "catalog:"
	}
}
