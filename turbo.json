{
	"$schema": "https://turborepo.com/schema.json",
	"remoteCache": { "signature": true },
	"globalDependencies": [".github/turbo-cache-epoch"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!e2e/**", "!playwright.config.ts"],
			"outputs": ["dist/**"]
		},
		"check": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!e2e/app/**"],
			"env": ["OGYGIA_BROWSERS"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!e2e/**", "!playwright.config.ts"],
			"outputs": []
		},
		"e2e": {
			"dependsOn": ["^build"],
			"outputs": ["playwright-results/**"],
			"cache": true,
			"env": ["E2E_NO_BUILD", "E2E_SHARD", "OGYGIA_BROWSERS"],
			"passThroughEnv": [
				"OGYGIA_*",
				"CI",
				"PLAYWRIGHT_*",
				"PW_*",
				"DEBUG",
				"HOME",
				"TMPDIR",
				"BUN_INSTALL"
			]
		},
		"fixture": {
			"dependsOn": ["^build"],
			"outputs": []
		}
	}
}
