{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!e2e/**", "!playwright.config.ts"],
			"outputs": ["dist/**"]
		},
		"check": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!e2e/app/**"],
			"outputs": [],
			"passThroughEnv": ["E2E_BROWSER_CHANNEL"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!e2e/**", "!playwright.config.ts"],
			"outputs": [],
			"passThroughEnv": ["E2E_BROWSER_CHANNEL"]
		},
		"e2e": {
			"dependsOn": ["^build"],
			"outputs": [],
			"cache": true,
			"env": ["E2E_NO_BUILD", "E2E_SHARD"],
			"passThroughEnv": [
				"OGYGIA_*",
				"CI",
				"PLAYWRIGHT_*",
				"PW_*",
				"DEBUG",
				"HOME",
				"TMPDIR",
				"BUN_INSTALL",
				"E2E_BROWSER_CHANNEL"
			]
		},
		"fixture": {
			"dependsOn": ["^build"],
			"outputs": []
		}
	}
}
